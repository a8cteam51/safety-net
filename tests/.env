# The path to the WordPress root directory, the one containing the wp-load.php file.
# This can be a relative path from the directory that contains the codeception.yml file,
# or an absolute path.
WORDPRESS_ROOT_DIR=/media/glynn/2024/devilbox_public/testing/htdocs
# WORDPRESS_ROOT_DIR=/shared/httpd/testing/htdocs

# Database settings for Devilbox
# Since Devilbox MySQL runs on 127.0.0.1 with user `root` and no password
WORDPRESS_DB_URL=mysql://root:@127.0.0.1:3306/testing

# The Integration suite will use this table prefix for the WordPress tables.
TEST_TABLE_PREFIX=test_

# This table prefix is used by the WordPress site in end-to-end tests.
WORDPRESS_TABLE_PREFIX=wp_

# The URL and domain of the WordPress site used in end-to-end tests.
WORDPRESS_URL=http://testing.gq
WORDPRESS_DOMAIN=testing.gq
WORDPRESS_ADMIN_PATH=/wp-admin

# The username and password of the administrator user of the WordPress site used in end-to-end tests.
WORDPRESS_ADMIN_USER=admin
WORDPRESS_ADMIN_PASSWORD=12345678

# ChromeDriver settings (Adjust if necessary for Devilbox)
CHROMEDRIVER_HOST=localhost
CHROMEDRIVER_PORT=4444